<Window x:Class="SSHProxyManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SSH Proxy Manager v1.0.0 | MHS"
        Height="750"
        Width="650"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Icon="icon.ico"
        Loaded="Window_Loaded"
        Background="#1E1E1E">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Margin"
                    Value="0,5,0,0"/>
            <Setter Property="Padding"
                    Value="8,6"/>
            <Setter Property="Background"
                    Value="#2D2D30"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="BorderBrush"
                    Value="#3F3F46"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground"
                    Value="#CCCCCC"/>
            <Setter Property="Margin"
                    Value="0,10,0,0"/>
            <Setter Property="FontSize"
                    Value="13"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="Padding"
                    Value="10,5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <!-- نمای اصلی (Main View) -->
        <Grid x:Name="MainView"
                Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- 0: تنظیمات -->
                <RowDefinition Height="Auto"/>
                <!-- 1: وضعیت و پینگ -->
                <RowDefinition Height="*"/>
                <!-- 2: لاگ SSH -->
                <RowDefinition Height="Auto"/>
                <!-- 3: دکمه تغییر نما -->
                <RowDefinition Height="Auto"/>
                <!-- 4: فوتر (اینجا درست است) -->
            </Grid.RowDefinitions>

            <!-- تنظیمات -->
            <StackPanel Grid.Row="0">
                <Label Content="🌐 Server IP/Domain:"/>
                <TextBox x:Name="txtIP"
                        Text=""/>
                <Label Content="👤 Username:"/>
                <TextBox x:Name="txtUsername"
                        Text=""/>
                <Label Content="🔑 Password:"/>
                <PasswordBox x:Name="pwdPassword"
                        Background="#2D2D30"
                        Foreground="White"
                        BorderBrush="#3F3F46"
                        BorderThickness="1"
                        Padding="8,6"
                        Margin="0,5,0,0"/>
                <Label Content="🔌 Local SOCKS Port:"/>
                <TextBox x:Name="txtPort"
                        Text="10808"/>
            </StackPanel>

            <!-- وضعیت و پینگ -->
            <StackPanel Grid.Row="1"
                    Margin="0,20,0,0">
                <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">
                    <Ellipse x:Name="statusIndicator"
                            Width="18"
                            Height="18"
                            Fill="Red"
                            Margin="0,0,10,0"
                            Stroke="#555555"
                            StrokeThickness="1"/>
                    <TextBlock x:Name="txtStatus"
                            Text="Disconnected"
                            FontSize="20"
                            FontWeight="Bold"
                            Foreground="White"
                            VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,8,0,0">
                    <TextBlock x:Name="txtPing"
                            Text="Ping: -- ms"
                            Foreground="#888888"
                            FontSize="13"
                            VerticalAlignment="Center"/>
                    <Button Content="📶 Check"
                            Width="70"
                            Height="28"
                            Margin="10,0,0,0"
                            FontSize="12"
                            Background="#3F3F46"
                            Foreground="White"
                            Click="BtnPing_Click"/>
                </StackPanel>

                <Button x:Name="btnConnect"
                        Content="▶ Connect"
                        Height="45"
                        Margin="0,15,0,0"
                        Background="#0E7A0D"
                        Foreground="White"
                        FontSize="16"
                        FontWeight="Bold"
                        Click="BtnConnect_Click"/>
            </StackPanel>

            <!-- لاگ اتصال SSH + دکمه Clear -->
            <GroupBox Grid.Row="2"
                    Header="📋 SSH Connection Log"
                    Foreground="#CCCCCC"
                    BorderBrush="#3F3F46"
                    Margin="0,15,0,0"
                    FontSize="13">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0"
                            Content="🗑 Clear Log"
                            Width="100"
                            Height="25"
                            HorizontalAlignment="Right"
                            Margin="0,0,0,5"
                            Background="#D32F2F"
                            Foreground="White"
                            FontSize="11"
                            Click="BtnClearLog_Click"/>
                    <TextBox Grid.Row="1"
                            x:Name="txtLog"
                            IsReadOnly="True"
                            VerticalScrollBarVisibility="Auto"
                            Background="#252526"
                            Foreground="#D4D4D4"
                            FontFamily="Consolas"
                            BorderThickness="0"
                            FontSize="12"/>
                </Grid>
            </GroupBox>

            <!-- دکمه تغییر نما به لاگ پروکسی -->
            <Button Grid.Row="3"
                    Content="🔄 Show SOCKS Proxy Logs"
                    Height="40"
                    Margin="0,15,0,0"
                    Background="#007ACC"
                    Foreground="White"
                    FontSize="14"
                    FontWeight="Bold"
                    Click="ShowProxyLogs_Click"/>

            <!-- ✅ بخش فوتر و معرفی سازنده (حالا جای درستش اینجاست) -->
            <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,15,0,5">
                <TextBlock Text="v1.0.0 | Developed by "
                        Foreground="#666666"
                        FontSize="11"
                        VerticalAlignment="Center"/>
                <TextBlock Text="Mohammad Hossein Soleymani (MHS)"
                        Foreground="#007ACC"
                        FontWeight="SemiBold"
                        FontSize="11"
                        VerticalAlignment="Center"/>
                <TextBlock Text=" | "
                        Foreground="#666666"
                        FontSize="11"
                        VerticalAlignment="Center"/>
                <TextBlock Text="github.com/m9h4s"
                        Foreground="#4EC9B0"
                        FontSize="11"
                        VerticalAlignment="Center"
                        Cursor="Hand"/>
            </StackPanel>
        </Grid>

        <!-- نمای لاگ پروکسی (Proxy Log View) -->
        <Grid x:Name="ProxyView"
                Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Button Grid.Row="0"
                    Content="⬅ Back to Main Screen"
                    Height="40"
                    Background="#3F3F46"
                    Foreground="White"
                    FontSize="14"
                    FontWeight="Bold"
                    Click="BackToMain_Click"
                    HorizontalAlignment="Left"
                    Width="200"/>

            <GroupBox Grid.Row="2"
                    Header="🔄 SOCKS Proxy Traffic &amp; Status Log"
                    Foreground="#CCCCCC"
                    BorderBrush="#3F3F46"
                    Margin="0,10,0,0"
                    FontSize="13">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0"
                            Content="🗑 Clear Proxy Log"
                            Width="130"
                            Height="25"
                            HorizontalAlignment="Right"
                            Margin="0,0,0,5"
                            Background="#D32F2F"
                            Foreground="White"
                            FontSize="11"
                            Click="BtnClearProxyLog_Click"/>
                    <TextBox Grid.Row="1"
                            x:Name="txtProxyLog"
                            IsReadOnly="True"
                            VerticalScrollBarVisibility="Auto"
                            Background="#1E1E1E"
                            Foreground="#4EC9B0"
                            FontFamily="Consolas"
                            BorderThickness="0"
                            FontSize="12"/>
                </Grid>
            </GroupBox>
        </Grid>
    </Grid>
</Window>