<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SSHProxyManager.MainWindow"
        Title="SSH Proxy Manager v1.0.0 | MHS"
        Height="750" Width="650"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Background="#1E1E1E">

    <Window.Styles>
        <Style Selector="TextBox">
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="TextBlock.header">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,5"/>
        </Style>
    </Window.Styles>

    <Grid Margin="20">
        <!-- نمای اصلی -->
        <Grid x:Name="MainView" IsVisible="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- تنظیمات -->
            <StackPanel Grid.Row="0">
                <TextBlock Classes="header" Text="🌐 Server IP/Domain:"/>
                <TextBox x:Name="txtIP"/>
                <TextBlock Classes="header" Text="👤 Username:"/>
                <TextBox x:Name="txtUsername"/>
                <TextBlock Classes="header" Text="🔑 Password:"/>
                <TextBox x:Name="pwdPassword" PasswordChar="●" Background="#2D2D30" Foreground="White" BorderBrush="#3F3F46"/>
                <TextBlock Classes="header" Text="🔌 Local SOCKS Port:"/>
                <TextBox x:Name="txtPort" Text="10808"/>
            </StackPanel>

            <!-- وضعیت و پینگ -->
            <StackPanel Grid.Row="1" Margin="0,20,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Ellipse x:Name="statusIndicator" Width="18" Height="18" Fill="Red" Margin="0,0,10,0" Stroke="#555555" StrokeThickness="1"/>
                    <TextBlock x:Name="txtStatus" Text="Disconnected" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                    <TextBlock x:Name="txtPing" Text="Ping: -- ms" Foreground="#888888" FontSize="13" VerticalAlignment="Center"/>
                    <Button Content="📶 Check" Width="80" Height="30" Margin="10,0,0,0" FontSize="12" Background="#3F3F46" Foreground="White" Click="BtnPing_Click"/>
                </StackPanel>

                <Button x:Name="btnConnect" Content="▶ Connect" Height="45" Margin="0,15,0,0" Background="#0E7A0D" Foreground="White" FontSize="16" FontWeight="Bold" Click="BtnConnect_Click"/>
            </StackPanel>

            <!-- لاگ SSH -->
            <Border Grid.Row="2" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="5" Margin="0,15,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="📋 SSH Connection Log" Foreground="#CCCCCC" FontSize="13" Margin="10,8,0,0" FontWeight="Bold"/>
                    <Button Grid.Row="1" Content="🗑 Clear Log" Width="100" Height="25" HorizontalAlignment="Right" Margin="0,5,10,5" Background="#D32F2F" Foreground="White" FontSize="11" Click="BtnClearLog_Click"/>
                    <TextBox Grid.Row="2" x:Name="txtLog" IsReadOnly="True" Background="#252526" Foreground="#D4D4D4" FontFamily="monospace" BorderThickness="0" Margin="5,0,5,5"/>
                </Grid>
            </Border>

            <!-- دکمه تغییر نما -->
            <Button Grid.Row="3" Content="🔄 Show SOCKS Proxy Logs" Height="40" Margin="0,15,0,0" Background="#007ACC" Foreground="White" FontSize="14" FontWeight="Bold" Click="ShowProxyLogs_Click"/>

            <!-- فوتر -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,5">
                <TextBlock Text="v1.0.0 | Developed by " Foreground="#666666" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Text="Mohammad Hossein Soleymani (MHS)" Foreground="#007ACC" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Text=" | " Foreground="#666666" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Text="github.com/m9h4s" Foreground="#4EC9B0" FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- نمای لاگ پروکسی -->
        <Grid x:Name="ProxyView" IsVisible="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Content="⬅ Back to Main Screen" Height="40" Background="#3F3F46" Foreground="White" FontSize="14" FontWeight="Bold" Click="BackToMain_Click" HorizontalAlignment="Left" Width="220"/>

            <Border Grid.Row="1" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="5" Margin="0,10,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="🔄 SOCKS Proxy Traffic &amp; Status Log" Foreground="#CCCCCC" FontSize="13" Margin="10,8,0,0" FontWeight="Bold"/>
                    <Button Grid.Row="1" Content="🗑 Clear Proxy Log" Width="130" Height="25" HorizontalAlignment="Right" Margin="0,5,10,5" Background="#D32F2F" Foreground="White" FontSize="11" Click="BtnClearProxyLog_Click"/>
                    <TextBox Grid.Row="2" x:Name="txtProxyLog" IsReadOnly="True" Background="#1E1E1E" Foreground="#4EC9B0" FontFamily="monospace" BorderThickness="0" Margin="5,0,5,5"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>